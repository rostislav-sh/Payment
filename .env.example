# Local run (api/relay/consumer via `uv run`, Postgres and RabbitMQ in Docker).
# Copy to .env. Inside docker compose these values are set in docker-compose.yml.

DATABASE_URL=postgresql+asyncpg://app:app@localhost:5433/payments
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
API_KEY=change-me

RELAY_BATCH_SIZE=100
RELAY_POLL_INTERVAL=0.5

CONSUMER_PREFETCH=10
WEBHOOK_TIMEOUT=5
GATEWAY_MIN_DELAY=2
GATEWAY_MAX_DELAY=5
GATEWAY_SUCCESS_RATE=0.9

LOG_LEVEL=INFO
